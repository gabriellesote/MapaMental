  "dimensoes": [
    {
      "id": "I",
      "nome": "Acessibilidade",
      "desc": "Condições que permitam aos usuários obter informações, incluindo a indicação clara do local de disponibilização, a forma de realizar eventual demanda, os prazos e outras características relevantes de acesso, assegurado tratamento especial às pessoas com deficiência."
    },
    {
      "id": "II",
      "nome": "Acurácia",
      "desc": "Medida em que a informação fornecida reflete a realidade de maneira precisa e confiável, de acordo com a metodologia utilizada."
    },
    {
      "id": "III",
      "nome": "Adaptabilidade",
      "desc": "Capacidade de gerar informações em formato que atenda às diversas demandas, incluindo as não periodicamente reportadas e as decorrentes de mudanças regulamentares, inclusive em situações adversas ou de crise."
    },
    {
      "id": "IV",
      "nome": "Clareza",
      "desc": "Apresentação das informações de forma concisa, permitindo a fácil compreensão e atendendo às necessidades do usuário."
    },
    {
      "id": "V",
      "nome": "Comparabilidade",
      "desc": "Capacidade de possibilitar ao usuário identificar e compreender semelhanças e diferenças entre informações, seja em diferentes períodos ou entre diferentes áreas geográficas ou domínios não geográficos."
    },
    {
      "id": "VI",
      "nome": "Completude",
      "desc": "Capacidade de a informação atender integralmente os aspectos requeridos, com dados completos."
    },
    {
      "id": "VII",
      "nome": "Confiabilidade",
      "desc": "Ausência de desvio relevante nos dados revisados em relação ao seu valor inicial."
    },
    {
      "id": "VIII",
      "nome": "Consistência",
      "desc": "Medida em que as informações referentes ao mesmo evento ou fato estão padronizadas e livres de contradições, mesmo quando geradas por diferentes fontes ou métodos."
    },
    {
      "id": "IX",
      "nome": "Integridade",
      "desc": "Propriedade pela qual se assegura que a informação é autêntica e que não foi modificada de maneira não autorizada ou acidental."
    },
    {
      "id": "X",
      "nome": "Rastreabilidade",
      "desc": "Condições que permitam rastrear a informação desde a origem até a sua disponibilização ao usuário final."
    },
    {
      "id": "XI",
      "nome": "Relevância",
      "desc": "Capacidade de fornecer informações úteis, que possam influenciar a tomada de decisões pelos usuários."
    },
    {
      "id": "XII",
      "nome": "Tempestividade",
      "desc": "Fornecimento das informações em tempo hábil, no prazo estabelecido, observado um curto intervalo entre os fatos relatados e a data da prestação da informação."
    }
  ],
